# --- PATH CONFIGURATION ---

# Absolute path to your local data folder.
# This is where download_kairosqa.py / download_taqa.py / download_olmes.py write,
# and where the evaluation scripts read datasets from (KairosQA, TAQA, OLMES).
DATA_DIR=./data

# Where evaluation runs write their results.
# Defaults to "./results" if unset.
RESULTS_DIR=./results


# --- KairosQA dataset creation (optional) ---

# Only needed if you regenerate KairosQA from a WikiData dump via
# `kairos/data/create_evals.py`. Not required to evaluate on the released dataset.
# OPENROUTER_API_KEY=
